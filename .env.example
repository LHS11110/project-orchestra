# Test credentials only. Do not copy JWT signing keys or CA private keys here.
ORCHESTRA_CONFIG=config/orchestra.json
ORCHESTRA_SERVICE_CA=/run/certs/services-ca.pem
ORCHESTRA_ES_CA=/run/certs/es-ca.crt
ORCHESTRA_REDIS_CA=/run/certs/redis-ca.crt
ORCHESTRA_SQL_CA=/run/certs/sql-ca.crt
ORCHESTRA_TEST_BEARER_TOKEN=
CPP_INTERNAL_API_TOKEN=
ORCHESTRA_ES_USER=agora_user
ORCHESTRA_ES_PASSWORD=
ORCHESTRA_SQL_USER=agora_user
ORCHESTRA_SQL_PASSWORD=
ORCHESTRA_REDIS_USER=agora_user
ORCHESTRA_REDIS_PASSWORD=
ORCHESTRA_SENTINEL_USER=agora_sentinel_reader
ORCHESTRA_SENTINEL_PASSWORD=
ORCHESTRA_CANVAS_PASSWORD=
# Host directory with public CA files only, mounted by Compose.
ORCHESTRA_CERT_DIR=./certificates
ORCHESTRA_ODBC_THREADS=16
ORCHESTRA_MAX_FAILURE_RATIO=0.01
ORCHESTRA_MAX_P95_MS=1000
