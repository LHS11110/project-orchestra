  "load": {
    "gateway": {
      "url": "https://agora-nginx",
      "ca_env": "ORCHESTRA_SERVICE_CA"
    },
    "frontend": {
      "url": "https://agora-frontend-dev:5173",
      "ca_env": "ORCHESTRA_SERVICE_CA"
    },
    "spring": {
      "url": "https://agora-spring:8080",
      "ca_env": "ORCHESTRA_SERVICE_CA"
    },
    "cpp": {
      "url": "https://agora-nginx:8444",
      "ca_env": "ORCHESTRA_SERVICE_CA",
      "server_id": 1
    },
    "phoenix": {
      "url": "https://agora-broker:4443",
      "ca_env": "ORCHESTRA_SERVICE_CA",
      "tls_server_name": "agora-nginx"
    },
    "elasticsearch": {
      "url": "https://agora-elasticsearch:9200",
      "ca_env": "ORCHESTRA_ES_CA",
      "index": "canvas"
    },
    "canvas": {
      "url": "https://agora-nginx",
      "ca_env": "ORCHESTRA_SERVICE_CA",
      "canvas_id": 1,
      "item_id": "orchestra-read-only"
    },
    "mssql": {
      "host": "agora-mssql",
      "port": 1433,
      "database": "agora_db",
      "tls_server_name": "agora-mssql"
    },
    "redis": {
      "master_name": "agora-master",
      "nodes": [
        {
          "identity": "172.20.0.2",
          "port": 6379,
          "dial_host": "agora-storage-broker",
          "dial_port": 16379
        },
        {
          "identity": "172.20.0.7",
          "port": 6379,
          "dial_host": "agora-storage-broker",
          "dial_port": 16380
        },
        {
          "identity": "172.20.0.5",
          "port": 6379,
          "dial_host": "agora-storage-broker",
          "dial_port": 16381
        }
      ],
      "sentinels": [
        {
          "identity": "172.20.0.6",
          "port": 26379,
          "dial_host": "agora-storage-broker",
          "dial_port": 26379
        },
        {
          "identity": "172.20.0.3",
          "port": 26379,
          "dial_host": "agora-storage-broker",
          "dial_port": 26380
        },
        {
          "identity": "172.20.0.4",
          "port": 26379,
          "dial_host": "agora-storage-broker",
          "dial_port": 26381
        }
      ],
      "document_key": "canvas:1"
    }
